res_rps_exp <- estimate_nt_elo_experiement(N_ids,N_opts,NT_matches,10)
sol <- res_rps_exp$sol
plot_nt_elo(sol,NT_thetas,N_ids,N_opts,labels=c("Rock","Paper","Scissors","Lizard","Spock"))
est_thetas <- as_tibble(elo_sol$par) |> rename(elo_theta='value') |> mutate(id=row_number())
est_thetas$rps_theta <- c(0,res_rps$sol$par[1:(N_ids-1)])
est_thetas$rps_exp_theta <- c(0,res_rps_exp$sol$par[1:(N_ids-1)])
est_thetas$true_theta <- NT_thetas
est_phis <- as_tibble(c(1:N_opts)) |> rename(hand='value')
est_phis$rps_phi <- c(0,res_rps$sol$par[N_ids:(N_ids + N_opts -2)])
est_phis$rps_exp_phi <- c(0,res_rps_exp$sol$par[N_ids:(N_ids + N_opts -2)])
