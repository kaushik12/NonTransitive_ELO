NT_matches <- NT_matches |> rename(player1="V1",
player2="V2",
hand1 = "V3",
hand2 = "V4",
result="V5",
d_theta="V6",
d_phi="V7",
g_d_phi="V8",
logit="V9",
p="V10")
NT_phis
