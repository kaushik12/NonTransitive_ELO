NT_thetas <- rnorm(N_ids)
delta_phi <- 2/N_opts
NT_phis <- seq(from=0,to=(2-delta_phi),length.out=N_opts)
NT_matches <- as.data.frame(do.call(
rbind,
replicate(N_games,simulate_NT_model(NT_thetas,NT_phis,N_opts,TRUE),simplify = FALSE)))
NT_matches <- NT_matches |> rename(player1="V1",
player2="V2",
hand1 = "V3",
hand2 = "V4",
result="V5",
d_theta="V6",
d_phi="V7",
g_d_phi="V8",
logit="V9",
p="V10")
View(NT_matches)
elo_sol <- fit_elo_model(N_ids,NT_matches)
plot_elo(elo_sol,NT_thetas)
res_rps <- estimate_nt_elo(N_ids,N_opts,NT_matches,10)
sol <- res_rps$sol
plot_nt_elo(sol,NT_thetas,N_ids,N_opts,labels=c("Rock","Paper","Scissors","Lizard","Spock"))
res_rps_exp <- estimate_nt_elo_experiement(N_ids,N_opts,NT_matches,10)
sol <- res_rps_exp$sol
plot_nt_elo(sol,NT_thetas,N_ids,N_opts,labels=c("Rock","Paper","Scissors","Lizard","Spock"))
ggplot(NT_matches,aes(x=p,y=result,color=factor(result))) +geom_point(size=1,alpha=0.5) + theme_bw() + labs(x="True Predicted Prob",y="Result",color="Result",title = "True Sim data")
ggplot(NT_matches,aes(x=p,y=result,color=factor(result))) +geom_point(size=0.5,alpha=0.5) + theme_bw() + labs(x="True Predicted Prob",y="Result",color="Result",title = "True Sim data")
ggplot(NT_matches,aes(x=p,y=result,color=factor(result))) +geom_point(size=0.5,alpha=0.25) + theme_bw() + labs(x="True Predicted Prob",y="Result",color="Result",title = "True Sim data")
est_thetas <- as_tibble(elo_sol$par) |> rename(elo_theta='value') |> mutate(id=row_number())
est_thetas$rps_theta <- c(0,res_rps$sol$par[1:(N_ids-1)])
est_thetas$rps_exp_theta <- c(0,res_rps_exp$sol$par[1:(N_ids-1)])
est_thetas$true_theta <- NT_thetas
est_phis <- as_tibble(c(1:N_opts)) |> rename(hand='value')
est_phis$rps_phi <- c(0,res_rps$sol$par[N_ids:(N_ids + N_opts -2)])
est_phis$rps_exp_phi <- c(0,res_rps_exp$sol$par[N_ids:(N_ids + N_opts -2)])
est_phis$true_phi <- NT_phis
NT_matches_predict <- NT_matches |>
left_join(est_thetas,by=join_by(player1==id)) |>
left_join(est_thetas,by=join_by(player2==id)) |>
left_join(est_phis,by=join_by(hand1==hand)) |>
left_join(est_phis,by=join_by(hand2==hand)) |>
mutate(elo_d_theta = elo_theta.x - elo_theta.y,
rps_d_theta = rps_theta.x - rps_theta.y,
rps_exp_d_theta = rps_exp_theta.x - rps_exp_theta.y,
true_d_theta = true_theta.x -true_theta.y,
rps_d_phi = rps_phi.x - rps_phi.y,
true_d_phi = true_phi.x - true_phi.y,
rps_exp_d_phi = rps_exp_phi.x - rps_exp_phi.y,
rps_g_d_phi = 2*sin(atan2(sinpi(rps_d_phi),cospi(rps_d_phi))),
rps_exp_g_d_phi = 2*atanh(sin(atan2(sinpi(rps_exp_d_phi),cospi(rps_exp_d_phi)))),
true_g_d_phi = 2*sin(atan2(sinpi(true_d_phi),cospi(true_d_phi))),
p_elo = plogis(elo_d_theta),
p_rps = plogis(rps_d_theta+rps_g_d_phi),
p_rps_exp = plogis(rps_exp_d_theta+rps_exp_g_d_phi),
p_true = plogis(true_d_theta+true_g_d_phi)
)
p1 <- ggplot(NT_matches_predict,aes(x=p_elo,y=result,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="ELO Predicted Prob",y="Result",color="Result",title = "ELO Model")
p2 <- ggplot(NT_matches_predict,aes(x=p_rps,y=result,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="NT-ELO Predicted Prob",y="Result",color="Result",title = "NT-ELO Model")
p3 <- ggplot(NT_matches_predict,aes(x=p_rps_exp,y=result,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="NT_Exp-ELO Predicted Prob",y="Result",color="Result",title = "Nt-Exp-ELO Model")
p4 <- ggplot(NT_matches_predict,aes(x=p_true,y=result,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="True Prob",y="Result",color="Result",title = "True Data")
p1 | p2 | p3 | p4
p1 <- ggplot(NT_matches_predict,aes(x=p_elo,y=p_true,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="ELO Predicted Prob",y="True p",color="Result",title = "ELO Model")
p2 <- ggplot(NT_matches_predict,aes(x=p_rps,y=p_true,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="NT-ELO Predicted Prob",y="True p",color="Result",title = "NT-ELO Model")
p3 <- ggplot(NT_matches_predict,aes(x=p_rps_exp,y=p_true,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="NT_Exp-ELO Predicted Prob",y="True p",color="Result",title = "Nt-Exp-ELO Model")
# p4 <- ggplot(NT_matches_predict,aes(x=p_true,y=result,color=factor(result))) +geom_point(size=0.25,alpha=0.25) + theme_bw() + labs(x="True Prob",y="Result",color="Result",title = "True Data")
p1 | p2 | p3
p1 <- ggplot(NT_matches_predict,aes(x=p_elo,y=p_true,color=factor(result))) +geom_point(size=1,alpha=0.25) + theme_bw() + labs(x="ELO Predicted Prob",y="True p",color="Result",title = "ELO Model")
p2 <- ggplot(NT_matches_predict,aes(x=p_rps,y=p_true,color=factor(result))) +geom_point(size=1,alpha=0.25) + theme_bw() + labs(x="NT-ELO Predicted Prob",y="True p",color="Result",title = "NT-ELO Model")
p3 <- ggplot(NT_matches_predict,aes(x=p_rps_exp,y=p_true,color=factor(result))) +geom_point(size=1,alpha=0.25) + theme_bw() + labs(x="NT_Exp-ELO Predicted Prob",y="True p",color="Result",title = "Nt-Exp-ELO Model")
