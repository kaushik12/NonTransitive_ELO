left_join(est_thetas,by=join_by(player2==id)) |>
left_join(est_phis,by=join_by(hand1==hand)) |>
left_join(est_phis,by=join_by(hand2==hand)) |>
mutate(elo_d_theta = elo_theta.x - elo_theta.y,
rps_d_theta = rps_theta.x - rps_theta.y,
rps_exp_d_theta = rps_exp_theta.x - rps_exp_theta.y,
true_d_theta = true_theta.x -true_theta.y,
rps_d_phi = rps_phi.x - rps_phi.y,
true_d_phi = true_phi.x - true_phi.y,
rps_exp_d_phi = rps_exp_phi.x - rps_exp_phi.y,
rps_g_d_phi = 2*sin(atan2(sinpi(rps_d_phi),cospi(rps_d_phi))),
rps_exp_g_d_phi = 2*atanh(sin(atan2(sinpi(rps_exp_d_phi),cospi(rps_exp_d_phi)))),
true_g_d_phi = 2*sin(atan2(sinpi(true_d_phi),cospi(true_d_phi))),
p_elo = plogis(elo_d_theta),
p_rps = plogis(rps_d_theta+rps_g_d_phi),
p_rps_exp = plogis(rps_exp_d_theta+rps_exp_g_d_phi),
p_true = plogis(true_d_theta+true_g_d_phi)
)
p1 <- ggplot(NT_matches_predict,aes(x=p_elo,y=p_true,color=factor(result))) +geom_point(size=1,alpha=0.5) + theme_bw() + labs(x="ELO Predicted Prob",y="True p",color="Result",title = "ELO Model")
p2 <- ggplot(NT_matches_predict,aes(x=p_rps,y=p_true,color=factor(result))) +geom_point(size=1,alpha=0.5) + theme_bw() + labs(x="NT-ELO Predicted Prob",y="True p",color="Result",title = "NT-ELO Model")
p3 <- ggplot(NT_matches_predict,aes(x=p_rps_exp,y=p_true,color=factor(result))) +geom_point(size=1,alpha=0.5) + theme_bw() + labs(x="NT_Exp-ELO Predicted Prob",y="True p",color="Result",title = "Nt-Exp-ELO Model")
