ggplot(NT_matches_predict,aes(x=p_rps,fill=factor(result))) +geom_density(alpha=0.5) + theme_bw() + labs(x="NT-ELO Predicted Prob",y="density",color="Result",title = "NT-ELO")
ggplot(NT_matches_predict,aes(x=p_rps_exp,fill=factor(result))) +geom_density(alpha=0.5) + theme_bw() + labs(x="NT-ELO Predicted Prob",y="density",color="Result",title = "NT-Exp-ELO")
